      if (daily[k]) { daily[k].orders++; daily[k].sales += tot; }
      var tb = tables[o.table] || (tables[o.table] = { table: o.table, orders: 0, sales: 0 });
      tb.orders++; tb.sales += tot;
      (o.items || []).forEach(function (it) {
