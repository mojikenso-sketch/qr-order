      if (topQty[0]) insights.push({ icon: 'crown', text: 'เมนูขายดีอันดับ 1 คือ "' + topQty[0].name + '" ขายได้ ' + topQty[0].qty + ' ที่ รวม ' + fmt(topQty[0].sales) + ' บาท' });
      if (prev.length) {
